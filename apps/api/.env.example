# MongoDB Atlas connection string
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority

# Secret for signing JWTs — generate with: openssl rand -base64 32
JWT_SECRET=REPLACE_WITH_A_STRONG_RANDOM_SECRET

# Port — Render sets this automatically, you don't need to set it there
PORT=5000

# Your frontend URL — for CORS (e.g. https://your-app.vercel.app)
CLIENT_URL=http://localhost:3000
# Optional comma-separated list of additional trusted frontend origins
CLIENT_URLS=

# Persistent upload storage path in production; defaults to ./uploads locally
UPLOAD_DIR=./uploads

# Private project source snapshots; must be outside UPLOAD_DIR/public /uploads static hosting
PROJECT_STORAGE_DIR=./private-projects

# Project import limits (conservative defaults)
PROJECT_MAX_UPLOAD_MB=100
PROJECT_MAX_EXTRACTED_MB=200
PROJECT_MAX_FILES=5000
PROJECT_MAX_ENTRIES=10000
PROJECT_MAX_PATH_DEPTH=20
PROJECT_MAX_COMPRESSION_RATIO=100
# Optional comma-separated additional directory names to omit from imports
PROJECT_EXCLUDED_DIRS=

# Project Analyzer limits and worker behavior
ANALYSIS_MAX_SOURCE_MB=20
ANALYSIS_TIMEOUT_SECONDS=180
ANALYSIS_WORKER_CONCURRENCY=1
ANALYSIS_MAX_ATTEMPTS=3
ANALYSIS_STALE_JOB_SECONDS=900
